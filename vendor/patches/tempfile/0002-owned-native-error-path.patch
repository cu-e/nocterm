+
+#[test]
+fn owned_error_path_preserves_original_named_writer_diagnostic() {
+    use std::io::Write;
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("read-only-handle");
+    std::fs::write(&path, b"old").unwrap();
+    let readonly = std::fs::File::open(&path).unwrap();
+    let prepared = tempfile::TempPath::from_prepared_path(path.clone().into_boxed_path());
+    let mut named = tempfile::NamedTempFile::from_parts(readonly, prepared);
+    let original = named.write(b"new").unwrap_err();
+    let native = std::fs::File::open(&path)
+        .unwrap()
+        .write(b"new")
+        .unwrap_err();
+    let wrapped = tempfile::error_with_owned_path(native, path.clone());
+    assert_eq!(original.kind(), wrapped.kind());
+    assert_eq!(format!("{original}"), format!("{wrapped}"));
+    assert_eq!(format!("{original:?}"), format!("{wrapped:?}"));
+    assert_eq!(
+        std::error::Error::source(&original).unwrap().to_string(),
+        std::error::Error::source(&wrapped).unwrap().to_string()
+    );
+    assert_eq!(
+        std::error::Error::source(std::error::Error::source(&original).unwrap()).is_some(),
+        std::error::Error::source(std::error::Error::source(&wrapped).unwrap()).is_some()
+    );
+    assert!(tempfile::path_error_allocation_bytes() >= std::mem::size_of::<std::path::PathBuf>());
+}
