+/// An admitted bounded output, preserving the real partial output on size refusal.
+pub enum ManagedDecompressionError<B: AllocationBudget> {
+    /// The original deflate grammar error.
+    Decompression(DecompressionError),
+    /// The caller refused an allocation before it occurred.
+    Allocation(AllocationRefused),
+    /// The original bounded-output rule, retaining its actual owned prefix.
+    OutputTooLarge(crate::budget::BudgetVec<u8, B>),
+}
+
+/// Decode through the original parser with an explicit instance-local account.
+pub fn decompress_to_vec_bounded_with_budget<B: AllocationBudget>(
+    input: &[u8],
+    maxlen: usize,
+    budget: B,
+) -> Result<crate::budget::BudgetVec<u8, B>, ManagedDecompressionError<B>> {
+    let mut decoder = Decompressor::new_with_budget(budget.clone())
+        .map_err(ManagedDecompressionError::Allocation)?;
+    let mut output =
+        crate::budget::BudgetVec::new(budget).map_err(ManagedDecompressionError::Allocation)?;
+    output
+        .resize(1024.min(maxlen), 0)
+        .map_err(ManagedDecompressionError::Allocation)?;
+    let mut input_index = 0;
+    let mut output_index = 0;
+    loop {
+        let (consumed, produced) = decoder
+            .read(&input[input_index..], &mut output, output_index, true)
+            .map_err(ManagedDecompressionError::Decompression)?;
+        input_index += consumed;
+        output_index += produced;
+        if decoder.is_done() || output_index == maxlen {
+            break;
+        }
+        output
+            .resize((output_index + 32 * 1024).min(maxlen), 0)
+            .map_err(ManagedDecompressionError::Allocation)?;
+    }
+    output
+        .resize(output_index, 0)
+        .map_err(ManagedDecompressionError::Allocation)?;
+    if decoder.is_done() {
+        Ok(output)
+    } else {
+        Err(ManagedDecompressionError::OutputTooLarge(output))
+    }
+}
