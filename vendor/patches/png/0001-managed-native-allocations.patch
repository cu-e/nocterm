+            _ => return Err(TextDecodingError::InvalidCompressionFlag.into()),
+        };
+        if compressed && compression_method != 0 {
+            return Err(TextDecodingError::InvalidCompressionMethod.into());
+        }
+        let language = decode_ascii(language_tag_slice).map_err(DecodingError::from)?;
+        let language_tag = budget::utf8(language.as_bytes(), &mut credit)?;
+        let translated_keyword = budget::utf8(translated_keyword_slice, &mut credit)?;
+        let text = if compressed {
+            OptCompressed::Compressed(budget::bytes(text_slice, &mut credit)?)
+        } else {
+            OptCompressed::Uncompressed(budget::utf8(text_slice, &mut credit)?)
+        };
+        Ok((
+            Self {
+                keyword,
+                compressed,
+                language_tag,
+                translated_keyword,
+                text,
+            },
+            credit,
+        ))
+    }
