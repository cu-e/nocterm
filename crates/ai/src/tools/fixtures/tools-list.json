{
  "jsonrpc": "2.0",
  "id": 2,
  "result": {
    "tools": [
      {
        "name": "list_terminals",
        "description": "List terminals attached to this chat, and attached servers that have no session yet (offline_servers). These are the only servers you can reach: nocterm holds their credentials, so never connect on your own with ssh. When the list is empty, tell the user to attach a terminal or server to the chat",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      {
        "name": "open_terminal",
        "description": "Connect to an attached offline server in the background, without disturbing the user; returns its terminal_id once connected. If it fails, tell the user in one short sentence why and stop",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "OpenTerminal",
          "description": "Connects to an attached offline server without opening a tab.",
          "type": "object",
          "properties": {
            "server_id": {
              "description": "An `offline_servers` entry of `list_terminals`.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "server_id"
          ]
        }
      },
      {
        "name": "read_terminal",
        "description": "Read bounded output of an attached terminal",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "ReadTerminal",
          "type": "object",
          "properties": {
            "terminal_id": {
              "type": "string"
            },
            "lines": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint",
              "minimum": 0
            },
            "since": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "terminal_id"
          ]
        }
      },
      {
        "name": "send_input",
        "description": "Send text to an attached terminal with user approval",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "SendInput",
          "type": "object",
          "properties": {
            "terminal_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "press_enter": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "required": [
            "terminal_id",
            "text"
          ]
        }
      },
      {
        "name": "run_command",
        "description": "Type one command into a known empty live shell prompt. Requires shell integration; an output pause never proves completion. Prefer exec_command for a reliable exit status",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "RunCommand",
          "type": "object",
          "properties": {
            "terminal_id": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "timeout_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "idle_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "terminal_id",
            "command"
          ]
        }
      },
      {
        "name": "exec_command",
        "description": "Run program with separate args and optional stdin on the attached terminal host over its current connection. Local execution passes args directly; SSH renders a POSIX command line, so arbitrary args require a POSIX-compatible remote command shell and are not guaranteed on Windows SSH. Fresh process: no inherited terminal cwd, environment, aliases or functions. Use an explicit shell for shell syntax. Returns actual exit status or an owned command_id for read_command/cancel_command. Output is bounded and continuously drained",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "ExecCommand",
          "description": "A fresh non-interactive program on this terminal's exact host connection.",
          "type": "object",
          "properties": {
            "terminal_id": {
              "type": "string"
            },
            "program": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "stdin": {
              "type": [
                "string",
                "null"
              ]
            },
            "timeout_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            },
            "yield_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "terminal_id",
            "program"
          ]
        }
      },
      {
        "name": "read_command",
        "description": "Read a bounded full snapshot of a command owned by this chat. Does not start or cancel a command; optional yield_ms waits briefly",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "ReadCommand",
          "type": "object",
          "properties": {
            "terminal_id": {
              "type": "string"
            },
            "command_id": {
              "type": "string"
            },
            "yield_ms": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "terminal_id",
            "command_id"
          ]
        }
      },
      {
        "name": "cancel_command",
        "description": "Cancel a command owned by this chat. SSH sends TERM and closes its channel; remote descendant termination is best effort",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "title": "CancelCommand",
          "type": "object",
          "properties": {
            "terminal_id": {
              "type": "string"
            },
            "command_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "terminal_id",
            "command_id"
          ]
        }
      }
    ]
  }
}
