[Unit]
Description=Nocterm fingerprint vault key broker
Requires=dbus.service
After=dbus.service

[Service]
Type=dbus
BusName=dev.nocterm.VaultBroker1
User=root
ExecStart=/usr/local/libexec/nocterm-vault-broker
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
LimitCORE=0
MemoryMax=128M
TasksMax=32
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target
