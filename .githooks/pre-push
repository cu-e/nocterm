#!/usr/bin/env bash
# Rejects a push whose third-party notices no longer match their inputs, or
# whose manifests declare unused dependencies: the same fast checks CI runs.
# Regenerate notices with scripts/generate-license-notices.py.
set -e
root="$(git rev-parse --show-toplevel)"
python3 "$root/scripts/generate-license-notices.py" --check-inputs
if command -v cargo-machete >/dev/null; then
  (cd "$root" && cargo machete --skip-target-dir)
else
  echo "pre-push: cargo-machete is not installed; CI checks unused dependencies" >&2
  echo "  (cargo install --locked --version 0.9.2 cargo-machete)" >&2
fi
